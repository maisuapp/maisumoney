// Prisma schema for MaisuMoney MVP
// Generated by Antigravity

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  holdings    Holding[]
  grids       Grid[]
  snapshots   PortfolioSnapshot[]
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


}

// Role will be stored as a string (SQLite does not support native enums).


model Holding {
  id                 Int      @id @default(autoincrement())
  user               User     @relation(fields: [userId], references: [id])
  userId             Int
  name               String
  account            String
  valuation          Int
  avgCost            Int
  currentNav         Int
  pl                 Int
  plPercent          Float
  monthlyContribution Int?
  orderDay           Int?
}

model Grid {
  id               Int      @id @default(autoincrement())
  user             User     @relation(fields: [userId], references: [id])
  userId           Int
  orderNumber      String @unique
  memo             String?
  pair             String
  side             String
  initialDate      DateTime
  rangeMin         Float
  rangeMax         Float
  trapCount        Int
  step             Float
  lotPerTrap       Int
  totalLot         Int
  profitWidth      Float
  profitAmount     Int
  stopLoss         Float
  rangeShift       Boolean
  trail            Boolean
  activePositions  Int
  heldUnits        Int
  avgPrice         Float
  unrealizedPL     Int
  positionPL       Int
  swapPL           Int
  totalStrategyPL  Int
  trapsJson        String   // JSON string of trap objects
}

model PortfolioSnapshot {
  id               Int      @id @default(autoincrement())
  user             User     @relation(fields: [userId], references: [id])
  userId           Int
  type             String   // "SBI" or "TORARIPI"
  dataJson         String   // full snapshot JSON
  createdAt        DateTime @default(now())
}


